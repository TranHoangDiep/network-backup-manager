# Copy to .env and adjust. Never commit .env.

# ---- App name shown in the UI and email subjects
APP_NAME=Network Config Backup
APP_SHORT_NAME=Config Backup

# ---- Timezone used for display and default schedules (IANA name)
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ---- Network egress allow-list: workers will ONLY connect to these networks/ports.
# Set this to your real management subnets reachable over the VPN.
ALLOWED_MGMT_NETWORKS=10.10.0.0/16,10.20.0.0/16
ALLOWED_PORTS=22,443,8443,10443

# ---- SSH host-key verification (keep true in production)
SSH_STRICT_HOST_KEY=true

# ---- HTTPS (gunicorn terminates TLS). A self-signed cert is generated on first
# start if none exists; replace data/certs/server.crt/.key with a CA-signed pair.
TLS_ENABLED=true
TLS_COMMON_NAME=config-backup.example.local
HTTPS_PORT=8443
SESSION_COOKIE_SECURE=true
SESSION_LIFETIME_MINUTES=480

# Set true only when running behind a trusted reverse proxy that sets X-Forwarded-*
TRUST_PROXY=false

# ---- Initial admin (used only when the users table is empty). Remove after first start.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# ---- Login protection
# Minimum user password length. Keep 12+ in production; lower only for local testing.
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_IP_MAX_ATTEMPTS=30

# ---- Web server
WEB_WORKERS=1
WEB_THREADS=8

# ---- Worker
MAX_CONCURRENCY_HARD_LIMIT=20
LOG_LEVEL=INFO

# Serve Bootstrap from static/vendor instead of the jsDelivr CDN (offline servers)
USE_CDN_ASSETS=true

# Container user mapping for bind-mounted ./data and ./keys
APP_UID=1000
APP_GID=1000
